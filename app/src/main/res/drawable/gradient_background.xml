<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#0D47A1" /></shape></item>
    <item><shape><gradient android:type="radial"
        android:centerX="50%" android:centerY="50%"
        android:gradientRadius="800dp"
        android:startColor="#80FFFFFF"
        android:endColor="#00000000" /></shape></item>
    <item><shape><gradient
        android:angle="90"
        android:startColor="#B3000000"
        android:endColor="#00000000" /></shape></item>
    <item><shape><gradient
        android:angle="270"
        android:startColor="#33FFFFFF"


        android:endColor="#00000000" /></shape></item>
</layer-list>