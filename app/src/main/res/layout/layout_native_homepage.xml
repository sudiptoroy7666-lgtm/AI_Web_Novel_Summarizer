<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="48dp">

        <!-- ── HEADER ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/applogo_vector"
                android:scaleType="centerInside"
                android:background="@drawable/applogo_vector"
                android:elevation="6dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Novel Summarizer"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI-powered summaries for web novels • Read faster • Never lose your place"
                android:textSize="14sp"
                android:textColor="#7FE5F2"
                android:gravity="center"
                android:paddingHorizontal="16dp"/>
        </LinearLayout>

        <!-- ── SEARCH CARD ────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1A0C4A6E"
            app:strokeColor="#406EDDD4"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍  Search or Enter URL"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#7BD2FA"
                    android:layout_marginBottom="4dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="5dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxBackgroundColor="#F2FFFFFF"
                    app:boxStrokeColor="#4006B6D4"
                    >

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/homeSearchInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textColorHint="#800891B2"
                        android:paddingTop="6dp"
                        android:imeOptions="actionGo"
                        android:inputType="textUri"
                        android:textColor="#0C4A6E"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="horizontal"
    >

    <ImageButton
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/settings_24"
        android:backgroundTint="#ADE1EB"
        android:contentDescription="Settings"

        >

    </ImageButton>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/settings_button"
        android:text="Settings"
        android:textSize="20sp"
        android:layout_marginStart="10dp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>



</LinearLayout>
        <!-- ── QUICK ACTIONS LABEL ────────────────────────────── -->



        <!-- ── QUICK ACTIONS GRID ─────────────────────────────── -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginBottom="8dp">

            <!-- Bookmarks -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBookmarks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A06B6D4"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#3006B6D4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="⭐"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:background="@drawable/home_action_icon_bg"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bookmarks"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saved pages"
                        android:textSize="11sp"
                        android:textColor="#81D5FB"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- History -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A06B6D4"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#3006B6D4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="🕒"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:background="@drawable/home_action_icon_bg"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="History"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent reads"
                        android:textSize="11sp"
                        android:textColor="#80D3FA"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Library -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLibrary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A06B6D4"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#3006B6D4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="📚"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:background="@drawable/home_action_icon_bg"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Library"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Summaries"
                        android:textSize="11sp"
                        android:textColor="#81D3FA"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <!-- ── SITES LABEL ────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐  Popular Novel Sites"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp"/>

        <!-- ── SITES GRID ─────────────────────────────────────── -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <!-- Royal Road -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSiteRoyalRoad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A06B6D4"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#2506B6D4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏰  Royal Road"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fantasy &amp; LitRPG"
                        android:textSize="12sp"
                        android:textColor="#82E8F6"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- WebNovel -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSiteWebNovel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A06B6D4"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#2506B6D4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📖  WebNovel"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Translations &amp; Originals"
                        android:textSize="12sp"
                        android:textColor="#80EDFA"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Scribble Hub -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSiteScribbleHub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A06B6D4"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#2506B6D4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✍️  Scribble Hub"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Original Fiction"
                        android:textSize="12sp"
                        android:textColor="#81EEFB"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- WuxiaWorld -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSiteWuxiaWorld"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A06B6D4"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#2506B6D4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️  WuxiaWorld"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asian Fantasy"
                        android:textSize="12sp"
                        android:textColor="#84F1FF"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSiteWTRLab"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A06B6D4"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#2506B6D4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️  WTR-Lab"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chinese/Korean/Japanese "
                        android:textSize="12sp"
                        android:textColor="#84F1FF"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSiteWattpad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1A06B6D4"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#2506B6D4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️  Wattpad"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teen fiction"
                        android:textSize="12sp"
                        android:textColor="#84F1FF"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


        </GridLayout>

        <!-- ── FOOTER ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap any site to start reading • Summarize with summarize button while browsing"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>



</androidx.core.widget.NestedScrollView>