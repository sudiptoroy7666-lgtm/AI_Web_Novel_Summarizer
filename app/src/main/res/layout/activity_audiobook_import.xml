<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_toolbar"
        android:elevation="6dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="Paste Book Text"
            app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <EditText
        android:id="@+id/etAudiobookTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Book title"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textColorHint="@color/text_hint" />

    <EditText
        android:id="@+id/etAudiobookContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/glass_panel"
        android:gravity="top|start"
        android:hint="Paste the full book text here..."
        android:inputType="textMultiLine|textNoSuggestions"
        android:overScrollMode="always"
        android:padding="16dp"

        android:scrollbars="vertical"
        android:textColor="@color/white"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveImportedBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#5790A9"
        android:layout_margin="16dp"
        android:text="Save Book"
        app:cornerRadius="12dp" />

</LinearLayout>